{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "headline", "overview", "directions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "headline": {"type": "string", "minLength": 1, "maxLength": 120},
    "overview": {"type": "string", "minLength": 1, "maxLength": 1200},
    "directions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "analysis", "papers"],
        "properties": {
          "key": {"type": "string"},
          "name": {"type": "string"},
          "analysis": {"type": "string", "minLength": 1, "maxLength": 2000},
          "papers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["paper_id", "reason"],
              "properties": {
                "paper_id": {"type": "string", "pattern": "^p[0-9]+$"},
                "reason": {"type": "string", "minLength": 1, "maxLength": 500}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cross_field": {"type": "string", "maxLength": 1200},
    "next_week": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 160}
    },
    "cited_paper_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^p[0-9]+$"}
    }
  },
  "additionalProperties": false
}
